# 默认：自动识别文本/二进制，归一化为 LF 入库
* text=auto eol=lf

# 脚本与文档统一 LF
*.md      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 批处理保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 字体与图片为二进制，禁止 diff/换行转换
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.png     binary
*.jpg     binary
*.gif     binary

# 学校模板原件：二进制，不做行尾转换与 diff
templates/**/*.doc   binary
templates/**/*.docx  binary
templates/**/*.pdf   binary

# Word/PDF 产物（.gitignore 已排除，此处防误加）
*.docx    binary
*.doc     binary
*.pdf     binary

# GitHub linguist：脚本按语言统计，文档不计入
skills/*/references/*.md linguist-documentation
README.md linguist-documentation
